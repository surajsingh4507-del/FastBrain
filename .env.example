# Copy to .env and fill in only what you use. Every key is optional:
# FastBrain runs fully offline with local models when none are set.

# Hosted decision model (TypeSafe Jev) for the SystemOne provider.
TYPESAFE_API_KEY=

# Hosted reasoning models. OpenRouter alone covers Anthropic, OpenAI, Google,
# Qwen, DeepSeek and more with one key.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Runtime settings.
FASTBRAIN_TRACE_DIR=.fastbrain/traces
FASTBRAIN_DEVICE=auto
FASTBRAIN_CAPTURE_CONTENT=true
FASTBRAIN_LOG_LEVEL=WARNING
